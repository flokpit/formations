{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flokpit/formations/specs/formation.schema.json",
  "title": "Formation",
  "description": "A predefined swarm of breeds (formations/v1alpha1). Cross-file rules (breeds exist, spawn rights and overrides only narrow) are checked by scripts/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "description", "status", "lead", "members", "spawn_tree", "work_split", "handoffs", "state", "verification", "termination", "limits", "channel", "escalate_to_human", "kickoff"],
  "properties": {
    "apiVersion": { "const": "formations/v1alpha1" },
    "kind": { "const": "Formation" },
    "name": { "$ref": "breed.schema.json#/$defs/breedName" },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposal", "active", "deprecated"] },
    "shape": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "integration_branch": { "type": "string", "minLength": 1 },
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breed"],
      "properties": {
        "breed": { "$ref": "breed.schema.json#/$defs/breedName" },
        "op": { "type": "boolean" },
        "overrides": { "$ref": "#/$defs/overrides" }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["breed", "count", "start"],
        "properties": {
          "breed": { "$ref": "breed.schema.json#/$defs/breedName" },
          "count": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer", "minimum": 0 },
              "max": { "type": "integer", "minimum": 1 }
            }
          },
          "start": { "enum": ["with_flock", "on_demand"] },
          "overrides": { "$ref": "#/$defs/overrides" }
        }
      }
    },
    "spawn_tree": {
      "type": "object",
      "propertyNames": { "$ref": "breed.schema.json#/$defs/breedName" },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "$ref": "breed.schema.json#/$defs/breedName" }
      }
    },
    "work_split": { "type": "string", "minLength": 1 },
    "handoffs": {
      "type": "object",
      "propertyNames": { "$ref": "breed.schema.json#/$defs/breedName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deliver", "to"],
        "properties": {
          "deliver": { "type": "string", "minLength": 1 },
          "to": { "$ref": "breed.schema.json#/$defs/breedName" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["github-issues"] },
        "label": { "type": "string", "minLength": 1 },
        "progress_file": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "verifier_is_not_author"],
      "properties": {
        "required": { "$ref": "#/$defs/conditionNames", "minItems": 1 },
        "optional": { "$ref": "#/$defs/conditionNames" },
        "verifier_is_not_author": { "type": "boolean" }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "summary"],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/conditionName" },
              {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "propertyNames": { "$ref": "#/$defs/conditionName" },
                "additionalProperties": { "type": ["integer", "string"] }
              }
            ]
          },
          "contains": { "const": "human_stop" }
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_agents", "max_lifetime", "max_budget_usd", "turn_budget"],
      "properties": {
        "max_agents": { "type": "integer", "minimum": 1 },
        "max_lifetime": { "$ref": "breed.schema.json#/$defs/duration" },
        "max_budget_usd": { "type": "number", "minimum": 0 },
        "turn_budget": { "type": "integer", "minimum": 1 }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "pattern": "^#" },
        "topic": { "type": "string" },
        "modes": { "type": "array", "uniqueItems": true, "items": { "enum": ["i", "m", "n", "s", "t", "k", "l", "M", "S"] } }
      }
    },
    "escalate_to_human": { "$ref": "#/$defs/conditionNames", "minItems": 1 },
    "kickoff": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "conditionName": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "conditionNames": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/conditionName" } },
    "overrides": {
      "description": "Narrowing overrides of a breed inside this formation; scripts/validate.py checks that they never widen.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "$ref": "breed.schema.json#/$defs/limits" },
        "lifecycle": { "$ref": "breed.schema.json#/$defs/lifecycle" },
        "tools": { "$ref": "breed.schema.json#/$defs/tools" }
      }
    }
  }
}
